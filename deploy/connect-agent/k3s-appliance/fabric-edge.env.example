# Abluva Connect Agent — k3s Appliance env file
# Fill these from the Day-1 install snippet in the Abluva UI, then run:
#   ./install.sh --env-file=./fabric-edge.env

# Required: Bootstrap token from UI (expires after FABRIC_BOOTSTRAP_TTL, default 7 days)
FABRIC_BOOTSTRAP_TOKEN=

# Required: Platform Gateway address (NLB host:port)
FABRIC_GATEWAY_ADDRESS=fabric.platform.example.com:8443

# Required: Control plane URL
FABRIC_CONTROL_PLANE_URL=https://cp.platform.example.com

# Required: Tenant UUID (from the Abluva UI tenant profile)
FABRIC_TENANT_ID=

# Optional: TLS server name for Gateway cert verification (if different from host)
# FABRIC_TLS_SERVER_NAME=fabric-gateway

# Optional: Path to CA trust bundle file (if not using --ca-url)
# CA_FILE=/path/to/ca.crt

# Optional: URL to fetch CA trust bundle from
# CA_URL=https://cp.platform.example.com/v1/ca-bundle

# Optional: Agent container image (defaults to latest from ghcr.io)
# AGENT_IMAGE=ghcr.io/abluva/connect-agent:latest
