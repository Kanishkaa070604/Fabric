# TEMPLATE ONLY — copy/rename to fabric-edge.env (install.sh sources that file).
#
# Place fabric-edge.env AND ca.crt in the SAME directory as install.sh
# (connect-agent/vm/k3s-appliance/), then run:
#   ./install.sh
#   # or: ./install.sh ./fabric-edge.env
#
# Same variables as kubernetes/tenant-start.env (required by install.sh
# the same way tenant-start.sh requires them).
#
# CA_CERT_FILE=./ca.crt is relative to that directory — do not leave ca.crt
# only in Downloads.
#
# Launcher (Deployment/agent) is a separate step after Agent Connected:
#   see deploy/agent/README.md
# Optional — if unset, install.sh derives <TENANT_ID>-<ENVIRONMENT_ID first 26 chars>
# (same as Connect UI / deploy-agent.sh).
# TENANT_NAMESPACE=abluva-connect
TENANT_ID=00000000-0000-0000-0000-000000000000
# Required when TENANT_NAMESPACE is omitted (namespace derivation + launcher).
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
# Platform NLB host:port (Terraform output fabric_gateway_address after Day 0).
FABRIC_GATEWAY_ADDRESS=fabric.platform.example.com:8443
# Optional SNI if it differs from the host above
# FABRIC_TLS_SERVER_NAME=fabric-gateway
FABRIC_CONTROL_PLANE_URL=https://control-plane.platform.example.com
CONNECT_AGENT_IMAGE=your-registry/connect-agent:VERSION
# Paths to Day-1 material from the UI (never commit these files).
CA_CERT_FILE=./ca.crt
BOOTSTRAP_TOKEN=paste-bootstrap-token-here
# Abluva SaaS namespace on the same cluster (hybrid). Used by NetworkPolicy.
# SAAS_NAMESPACE=3407e407-792a-452d-8bb4-03c54ac34d52-5620f907-0281-497d-9098-8c
