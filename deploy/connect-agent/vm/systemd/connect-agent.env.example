# Connect Agent — VM / bare-metal environment file (see connect-agent.service)
FABRIC_GATEWAY_ADDRESS=fabric.platform.example.com:8443
FABRIC_TENANT_ID=REPLACE_TENANT_UUID
FABRIC_CONTROL_PLANE_URL=https://control-plane.platform.example.com
FABRIC_LOG_LEVEL=info

# Developer-Reference: VM substrate listens on loopback by default — never
# 0.0.0.0 here (unlike the Kubernetes DaemonSet, which relies on a
# NetworkPolicy at the pod-network layer instead of loopback).
FABRIC_LISTEN_HOST=127.0.0.1
FABRIC_LISTEN_BASE_PORT=9443
# L3-AGT-02: writable dir for per-instance leaf (tls.crt/tls.key). CA trust
# is separate (FABRIC_AGENT_CA_FILE); do not share one leaf across hosts.
FABRIC_AGENT_CERT_DIR=/var/lib/connect-agent/tls
FABRIC_AGENT_CA_FILE=/etc/connect-agent/tls/ca.crt
FABRIC_AGENT_ID_PATH=/var/run/abluva/agent-id
# FABRIC_BOOTSTRAP_TOKEN=...   # install window only; multi-redeem until expiry

# Spec §10.1 optional strict substrate binding (leave unset unless the
# tenant enabled it in the Platform UI at onboarding — see
# POST /v1/tenants/{id}/substrate-binding).
FABRIC_SUBSTRATE=vm
# FABRIC_SUBSTRATE_FINGERPRINT=REPLACE_CLOUD_ACCOUNT_OR_HOST_UID

# Routing note (same as the Kubernetes DaemonSet): Agent<->Gateway is raw
# mTLS TCP. If this host has a corporate HTTP(S) proxy configured, NO_PROXY
# MUST cover the Gateway host or the tunnel will break.
NO_PROXY=fabric.platform.example.com,localhost,127.0.0.1
no_proxy=fabric.platform.example.com,localhost,127.0.0.1
