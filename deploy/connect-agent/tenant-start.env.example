# Values for deploy/connect-agent/tenant-start.sh
# Fill from the Abluva Connect UI "Install" snippet (Day-1), then:
#   ./tenant-start.sh ./tenant-start.env
#
# Unlike secure-agent-net's Skupper tenant-start.sh, this Agent dials OUT to
# the Platform OCI NLB. You do NOT install Skupper, MetalLB, or redeem a link token.
TENANT_NAMESPACE=abluva-connect
TENANT_ID=00000000-0000-0000-0000-000000000000
# Platform NLB host:port (Terraform output fabric_gateway_address after Day 0).
FABRIC_GATEWAY_ADDRESS=fabric.platform.example.com:8443
# Optional SNI if it differs from the host above
# FABRIC_TLS_SERVER_NAME=fabric-gateway
FABRIC_CONTROL_PLANE_URL=https://control-plane.platform.example.com
CONNECT_AGENT_IMAGE=your-registry/connect-agent:VERSION
# Paths to Day-1 material from the UI (never commit these files).
CA_CERT_FILE=./ca.crt
BOOTSTRAP_TOKEN=paste-bootstrap-token-here
# No separate Agent API token needed — the Agent derives its bearer from
# the leaf cert after enrollment (enroll authenticates with the bootstrap
# token in the request body, not a separate bearer header).
# Optional: skip NetworkPolicy (not recommended)
# SKIP_NETWORK_POLICY=0
