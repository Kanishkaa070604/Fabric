# Optional: --env-file=./deploy-agent.env
# Preferred: pass flags (script writes this file):
#
#   ./deploy-agent.sh -t <TENANT_ID> -e <ENVIRONMENT_ID> -m <EMAIL> -p <PORT>
#   KUBECTL="k3s kubectl" ./deploy-agent.sh -t ... -e ... -m ... -p ... --vm

TENANT_NAMESPACE=abluva-connect
TENANT_ID=00000000-0000-0000-0000-000000000000
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
X_ABLV_PRINCIPAL=you@yourcompany.com
CONTROL_SERVER_LISTEN_PORT=9444
