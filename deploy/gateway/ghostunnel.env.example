# Ghostunnel — Platform Gateway pod only (Architecture-Resolutions GT)
# Official docs: https://ghostunnel.dev/docs/reference/manpage-linux/
# Take only what we need: --allow-all (CA-enforced), no OPA.

# Example process args (secrets mounted from Access API / vault prefix ablv-fabric):
#
# ghostunnel server \
#   --listen 0.0.0.0:8443 \
#   --target unix:/var/run/fabric/gateway.sock \
#   --cert /etc/fabric/tls/gateway-cert.pem \
#   --key /etc/fabric/tls/gateway-key.pem \
#   --cacert /etc/fabric/tls/intermediate-ca.pem \
#   --allow-all \
#   --proxy-protocol-mode=tls-full \
#   --status http://127.0.0.1:6060 \
#   --timed-reload 300s

GHOSTUNNEL_LISTEN=0.0.0.0:8443
GHOSTUNNEL_TARGET=unix:/var/run/fabric/gateway.sock
GHOSTUNNEL_ALLOW=all
GHOSTUNNEL_PROXY_PROTOCOL_MODE=tls-full
GHOSTUNNEL_STATUS=http://127.0.0.1:6060
GHOSTUNNEL_TIMED_RELOAD=300s
