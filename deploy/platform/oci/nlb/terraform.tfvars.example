# New Fabric Gateway NLB (leave old mesh-gateway-nlb alone until cutover).
# Blind steps: docs/Operational-Runbook.md Day 0 Step 5b
# Collect backends after NodePort: ./collect-backend-values.sh

compartment_ocid = "ocid1.compartment.oc1..aaaa..." # Identity → Compartments → OCID
subnet_ocid      = "ocid1.subnet.oc1..aaaa..."      # Same public subnet as mesh-gateway-nlb is fine

display_name = "fabric-gateway-nlb" # NEW name — do not reuse mesh-gateway-nlb

# From ./collect-backend-values.sh (worker InternalIPs + NodePorts).
backend_ip_addresses = [
  "10.0.10.11",
  "10.0.10.12",
]

# Agent dial (Ghostunnel) — REQUIRED
backend_port  = 32443 # NodePort for Service port 8443 — NOT 8443 unless hostPort
listener_port = 8443

# Platform→Customer inbound (A3/B4) — keep true if Gateway has :8444
enable_inbound        = true
inbound_backend_port  = 32444 # NodePort for Service port 8444
inbound_listener_port = 8444

# FQDN for FABRIC_GATEWAY_ADDRESS (with :8443). Point A record at NEW NLB VIP after apply.
dns_hostname = "fabric.abluva.com"

# Optional OCI DNS A record. Leave empty if Cloudflare owns the A record.
# oci_dns_zone_ocid        = "ocid1.dns-zone.oc1..aaaa..."
# oci_dns_compartment_ocid = "ocid1.compartment.oc1..aaaa..."

is_private = false

# NOT on this NLB:
#   - control-plane :8080  → separate HTTPS Ingress/LB (A6p)
#   - revoke push :9090    → in-cluster fabric-gateway Service only
