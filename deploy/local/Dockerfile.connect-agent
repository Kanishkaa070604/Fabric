FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY connect-agent/go.mod connect-agent/go.sum ./
RUN go mod download
COPY connect-agent/ ./
RUN CGO_ENABLED=0 go build -o /connect-agent ./cmd/connect-agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /connect-agent /connect-agent
USER nonroot:nonroot
ENTRYPOINT ["/connect-agent"]
