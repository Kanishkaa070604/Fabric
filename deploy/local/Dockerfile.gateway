FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY gateway/go.mod gateway/go.sum ./
RUN go mod download
COPY gateway/ ./
RUN CGO_ENABLED=0 go build -o /fabric-gateway ./cmd/gateway

FROM gcr.io/distroless/static-debian12
COPY --from=build /fabric-gateway /fabric-gateway
ENTRYPOINT ["/fabric-gateway"]
